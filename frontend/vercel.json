{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://accounts.google.com https://www.gstatic.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://flock-app-production.up.railway.app https://api.maptiler.com https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://api.dicebear.com https://*.googleusercontent.com https://maps.googleapis.com https://www.gstatic.com; font-src 'self' data:; media-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://accounts.google.com; connect-src 'self' https://flock-app-production.up.railway.app wss://flock-app-production.up.railway.app https://api.maptiler.com https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://us.i.posthog.com https://us-assets.i.posthog.com https://accounts.google.com https://*.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; manifest-src 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), browsing-topics=()" }
      ]
    },

    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/marks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/birdie/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(og-image.png|favicon.ico|logo192.png|logo512.png|apple-touch-icon.png|appstore-icon-1024.png|flock-logo.png|birdie-avatar.png|birdie-avatar-light.png|birdie-head.png|bg-city.mp4|bg-city-venue.mp4|bg-city-poster.jpg|bg-city-venue-poster.jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },

    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/landing",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/about>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/support",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/support>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/privacy>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/terms>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/guidelines",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/guidelines>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/delete-account",
      "headers": [
        { "key": "Link", "value": "<https://www.flockcorp.com/delete-account>; rel=\"canonical\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },

    {
      "source": "/i",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/i/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/i/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Applebot|redditbot|Pinterest|SkypeUriPreview|Iframely|Embedly|vkShare|Bluesky|bskylink|Mastodon|Snapchat|nuzzel).*"
        }
      ],
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/checkin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/f/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/flock/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/dm/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/api/marketing-page",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/i/:token",
      "has": [{ "type": "query", "key": "open" }],
      "destination": "/index.html"
    },
    {
      "source": "/i/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Applebot|redditbot|Pinterest|SkypeUriPreview|Iframely|Embedly|vkShare|Bluesky|bskylink|Mastodon|Snapchat|nuzzel).*"
        }
      ],
      "destination": "/api/invite-preview?token=:token"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|DuckAssistBot|Amazonbot|Meta-ExternalAgent|meta-externalagent|Meta-ExternalFetcher|meta-externalfetcher|Bytespider|CCBot|cohere-ai|cohere-training-data-crawler|MistralAI-User).*"
        }
      ],
      "destination": "/api/marketing-page?page=home"
    },
    {
      "source": "/:page(about|support|privacy|terms)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|DuckAssistBot|Amazonbot|Meta-ExternalAgent|meta-externalagent|Meta-ExternalFetcher|meta-externalfetcher|Bytespider|CCBot|cohere-ai|cohere-training-data-crawler|MistralAI-User).*"
        }
      ],
      "destination": "/api/marketing-page?page=:page"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
