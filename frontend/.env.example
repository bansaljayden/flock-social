# Flock frontend (CRA) — environment variables
#
# Copy to `frontend/.env` for local dev. In production these are set in the
# Vercel project (web) and in the Codemagic env group `flock_web` (the iOS
# Capacitor build) — never commit real values.
#
# CRA inlines every REACT_APP_* var into the JS bundle at BUILD time. Two
# consequences: (1) nothing here is secret, so only ever put publishable keys
# in this file; (2) changing a value requires a rebuild, not just a redeploy.
# Anything not prefixed REACT_APP_ is ignored by the build entirely.

# Missing: falls back to https://flock-app-production.up.railway.app
# (services/api.js:1). Only set this to point a build at a staging backend.
REACT_APP_API_URL=

# Google Identity Services client id, must match the backend's GOOGLE_CLIENT_ID.
# Missing: the "Continue with Google" button does not render.
# NOTE: GIS also refuses to render on any origin not registered in the Google
# Cloud console, so a correct key alone is not enough — see DOMAIN.md step 4.
REACT_APP_GOOGLE_CLIENT_ID=

# MapTiler style key. Missing: maps still work but silently fall back to the
# CARTO Positron basemap (App.js:699, website/LiveDemo.js:16) — the app renders
# a light generic map instead of the intended dark style.
REACT_APP_MAPTILER_KEY=
# MapTiler + MapLibre GL are the ONLY map stack. There is no Google Maps JS SDK
# anywhere in src/, so do not add REACT_APP_GOOGLE_MAPS_API_KEY here, to your
# local .env, to Vercel, or to Codemagic's flock_web group. It used to be set
# and shipped a billable Google key inside build/static/js/*.js to every
# visitor for a feature that does not exist — see the DefinePlugin note at the
# top of this file. Enforced by src/__tests__/noUnusedGoogleApiKey.test.js.

# Firebase Web SDK config — push notifications (FCM). All six are needed together.
# Missing: web push registration fails; REACT_APP_FIREBASE_VAPID_KEY missing
# specifically logs "[Firebase] VAPID key not set" and returns no token, so the
# device is never registered and receives nothing (services/firebase.js:120).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=

# PostHog product analytics. Missing: posthog-js is never even dynamically
# imported, so analytics is fully disabled (index.js:58, services/api.js:14).
# When SET, PostHog identifies users by numeric account id
# (services/api.js:29) — this must be declared in the App Privacy labels.
# REACT_APP_POSTHOG_HOST missing: defaults to https://us.i.posthog.com.
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# A DEV SERVER IS NOT A USER, and this variable is the exception to that.
#
# A key in a local .env used to mean every "npm start" reported into the live
# project. Measured on 2026-08-25: 1,526 of 1,794 pageviews in the whole
# history of the project came from a localhost origin and 244 from
# www.flockcorp.com, so the headline number, and every ratio built on it, was
# mostly a dev server being restarted. index.js now refuses to initialize on a
# local http origin. The two native shells are not caught by that: iOS serves
# from capacitor://localhost and Android from https://localhost with the
# Capacitor bridge present, and both still report.
#
# Set this to the string true only when you are deliberately testing that the
# analytics pipeline still works end to end, and unset it afterwards.
REACT_APP_POSTHOG_ALLOW_LOCAL=

# Missing: Sentry never initializes and frontend crashes go unreported
# (index.js:23, components/ErrorBoundary.js:65).
REACT_APP_SENTRY_DSN=

# RevenueCat PUBLIC Apple SDK key (starts with appl_). Publishable, but it still
# belongs in Codemagic's `flock_web` env group, not the repo.
# Missing: isPurchasesAvailable() is false (services/purchases.js:24), so the
# paywall never shows and no purchase can be made even with PAYWALL_ENABLED=true
# on the backend. See PAYWALL.md.
REACT_APP_REVENUECAT_IOS_KEY=
