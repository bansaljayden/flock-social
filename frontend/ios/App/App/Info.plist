<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Flock</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only. Every screen in the app is laid out as a single portrait
	     column (bottom tab bar, full-height chat, bottom sheets), so declaring
	     landscape advertised a layout the app has never supported. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- When-in-use only, and that is the whole story: the app reads location
	     through the web navigator.geolocation API for nearby venues, in-flock
	     live share, and the SOS alert. No always-authorization API is reachable
	     any more (the unused @capacitor/geolocation plugin was removed, which is
	     what forced the ITMS-90683 always-usage string that used to sit here),
	     and no location background mode is declared. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Flock uses your location to show nearby venues and crowd levels, share live location with your group while a flock is active, and send your location to trusted contacts when you tap SOS.</string>
	<!-- Camera: the in-app viewfinder uses getUserMedia inside the web view.
	     Photo library read: the "choose from gallery" file input. There is no
	     save-to-library flow anywhere in the app, so no NSPhotoLibraryAdd. -->
	<key>NSCameraUsageDescription</key>
	<string>Flock uses the camera to take photos for your stories and chat messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Flock accesses your photos so you can share them in stories and chat messages.</string>
	<!-- Payment apps only. The bill-split screen opens Venmo, Cash App, and
	     Zelle handles, so it needs to query whether those apps are installed.
	     tel/sms/mailto are handled by the system without being declared. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>venmo</string>
		<string>cashapp</string>
		<string>cash-app</string>
		<string>zelle</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
