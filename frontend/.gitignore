.vercel

# Cloudflare Pages local runs (`wrangler pages dev` from this directory):
# .wrangler/ is wrangler's own state and cache, and .dev.vars (or
# .dev.vars.<environment>) holds the local values of the Functions' secrets,
# RELAY_SIGNING_SECRET and OG_CARD_SECRET.
.wrangler/
.dev.vars*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Video the beat recorder writes when --out is left off. Its real output goes
# to the film's own footage directory, outside this repo; this is the fallback
# it falls into when somebody runs it bare, and it is tens of megabytes.
/beat-footage/
