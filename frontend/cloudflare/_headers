# Invite links. vercel.json splits /i/(.*) into two rules so that
# "private, no-store" skips preview bots. Here a preview bot's response is
# built by a Function and never sees this file, so one unconditional block
# covers exactly the responses the two Vercel rules covered. The one
# difference: a preview bot that asks for /i/<token>?open=1 gets the SPA with
# no-store, where Vercel sent the SPA with its default revalidate header.
/i
  X-Robots-Tag: noindex, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/i/*
  X-Robots-Tag: noindex, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/app
  X-Robots-Tag: noindex
  Link: <https://accounts.google.com>; rel=preconnect
  Cache-Control: public, max-age=0, must-revalidate

/app/*
  X-Robots-Tag: noindex
  Link: <https://accounts.google.com>; rel=preconnect
  Cache-Control: public, max-age=0, must-revalidate

/signup
  X-Robots-Tag: noindex
  Link: <https://accounts.google.com>; rel=preconnect
  Cache-Control: public, max-age=0, must-revalidate

/reset-password
  X-Robots-Tag: noindex, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/verify-email
  X-Robots-Tag: noindex, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/checkin/*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/f/*
  X-Robots-Tag: noindex
  Cache-Control: private, no-store

/flock/*
  X-Robots-Tag: noindex
  Cache-Control: private, no-store

/dm/*
  X-Robots-Tag: noindex
  Cache-Control: private, no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

