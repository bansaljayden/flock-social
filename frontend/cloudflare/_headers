# Cloudflare Pages response headers for flockcorp.com: the per-path half.
# Port of the "headers" block in frontend/vercel.json.
#
# scripts/build-cloudflare.js writes build/_headers as a "/*" block built from
# cloudflare/security-headers.json followed by this file. Edit the security
# headers there, not here.
#
# How Pages reads _headers (developers.cloudflare.com/pages/configuration/headers/):
# - Every rule whose pattern matches the request path applies. The first rule
#   to name a header replaces Pages' default for it; a later rule naming the
#   same header is joined onto it with ", ". So no two rules that can match
#   the same path set the same header below.
# - Two blocks with the same path do not merge: the last one replaces the
#   first. vercel.json has two "/i/(.*)" rules; they are one block here.
# - These rules never touch a response a Pages Function builds; the middleware
#   adds the security headers to those.
# - Limits: 100 rules, 2,000 characters per line.

# The project's own <project>.pages.dev host serves the same site as
# www.flockcorp.com, and so does every deployment's own
# <hash>.<project>.pages.dev URL, the production deployment's included. Pages'
# asset server marks the second shape noindex by itself (wrangler 4.148.0's
# copy decides by the host having more than three labels) but never the
# first. Both are marked here anyway, the pair Cloudflare's docs give for
# keeping pages.dev out of search results, so neither depends on that
# internal check. Function answers get the same header from the middleware.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Apple's app-site-association file, written into the build by
# scripts/build-cloudflare.js from APPLE_TEAM_ID (the same body the
# api/apple-app-site-association.js handler returns). Served as a file so it
# never depends on the Functions quota. No extension, so the type is stated.
/.well-known/apple-app-site-association
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

