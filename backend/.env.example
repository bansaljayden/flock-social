# Flock backend — environment variables
#
# Copy to `backend/.env` for local dev. In production these live in the Railway
# service variables — never commit real values (a gitleaks pre-commit hook enforces this).
#
# Each entry says what BREAKS when it is missing. Three of them fail OPEN
# (moderation, NFC trust, admin provisioning), so a missing value degrades
# safety silently instead of crashing — read those notes before shipping.

# ---------------------------------------------------------------------------
# Core — the server will not work without these
# ---------------------------------------------------------------------------

# Missing: every query fails. server.js logs "DATABASE_URL: [missing]" at boot
# and the pool never connects. Railway injects this automatically.
# QUARANTINE (post-outage 2026-08-13): if this (or PGHOST) points at a Railway
# host (*.rlwy.net / *.railway.app / *.railway.internal) while NODE_ENV is not
# "production", server.js REFUSES to boot — a plain local `node server.js` used
# to run migrations against the live database. See
# I_UNDERSTAND_THIS_IS_PRODUCTION below for the deliberate-use override.
DATABASE_URL=postgresql://user:password@host:5432/flock_db

# Missing: HARD EXIT in production (server.js:8-14). Outside production it only
# warns, and then every login/signup and all authenticated routes throw 500s.
JWT_SECRET=your-super-secret-jwt-key-change-this

# Missing: defaults to 5000 (server.js:335). Railway sets this itself.
PORT=5000

# Missing: treated as development — TLS verification for Postgres is disabled,
# Sentry environment is "development", and the JWT_SECRET guard only warns.
NODE_ENV=development

# Missing: CORS allowlist falls back to http://localhost:3000 (server.js:67), so
# a deployed frontend on any other origin has every API call blocked by CORS.
FRONTEND_URL=http://localhost:3000

# Missing: falls back to https://flock-app-w65m.vercel.app. Used for NFC
# check-in redirects, flock invite links, and the waitlist email logo — so
# links mailed to users point at the old Vercel host instead of flockcorp.com.
PUBLIC_WEB_URL=https://flockcorp.com

# ---------------------------------------------------------------------------
# Auth providers
# ---------------------------------------------------------------------------

# Missing: "Continue with Google" returns 503 (routes/auth.js:243). Must match
# the client's REACT_APP_GOOGLE_CLIENT_ID or the audience check rejects tokens.
GOOGLE_CLIENT_ID=

# Sign in with Apple. APPLE_CLIENT_ID/APPLE_BUNDLE_ID default to
# com.flockcorp.flock. Missing TEAM_ID/KEY_ID/PRIVATE_KEY: account deletion
# still deletes the row but CANNOT revoke the Apple token — Apple 5.1.1(v)
# requires revocation, so this is a review-rejection risk, not just a bug.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=com.flockcorp.flock
APPLE_BUNDLE_ID=com.flockcorp.flock

# ---------------------------------------------------------------------------
# Moderation — FAILS OPEN. Read this block before any store submission.
# ---------------------------------------------------------------------------

# Google Cloud Vision SafeSearch key (enable the Vision API on the same GCP
# project as Places/Gemini). GOOGLE_VISION_API_KEY is accepted as a legacy
# alias (utils/moderation.js:63).
# Missing: image moderation has NO provider. Combined with
# IMAGE_MODERATION_REQUIRED unset, every uploaded image is ALLOWED with only a
# console warning — unscreened photo UGC on a teen app.
# NOTE: this replaced OpenModerator, whose hosted service was shut down.
# OPENMODERATOR_API_KEY is dead and is read nowhere in this codebase.
VISION_API_KEY=

# Missing/not "true": moderation fails OPEN (allow-with-warning). Set to true
# in production so an unconfigured or erroring provider rejects the upload
# instead of publishing it (utils/moderation.js:53, :80-89).
IMAGE_MODERATION_REQUIRED=false

# Comma-separated user IDs promoted to role='admin' on every boot (server.js:319).
# Missing: NO account has the admin role, so the moderation console is
# unreachable and inbound user reports are never actioned — the exact thing
# Apple Guideline 1.2 requires. Fails silently.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Third-party APIs — features degrade individually, server still boots
# ---------------------------------------------------------------------------

# Google Places (server-side key; do NOT reuse the browser-restricted Maps key).
# Missing: venue search, crowd lookups, venue badges, the venue dashboard and
# Birdie's venue suggestions all return empty or error.
GOOGLE_PLACES_API_KEY=

# Missing: Birdie (the AI assistant) is disabled — routes/ai.js never builds a
# client, so every Birdie request fails.
GEMINI_API_KEY=

# Missing: defaults to gemini-3.5-flash-lite (routes/ai.js:33). Only set this
# to pin or change the Birdie model.
BIRDIE_MODEL=

# OpenWeatherMap. Missing: weather features are skipped with a one-time warning
# and the crowd model loses its weather inputs, degrading prediction accuracy.
WEATHER_API_KEY=

# Missing: the events feed returns nothing AND the ML predictor's nearby-event
# features are all zero (services/mlPredictor.js:351) — a known live gap noted
# in scripts/ml/RETRAIN.md.
TICKETMASTER_API_KEY=

# Missing: safety/SOS alert emails, waitlist confirmations, email verification,
# password reset, and moderation alert emails are all silently skipped
# (routes/safety.js, routes/waitlist.js, services/emailService.js,
# services/moderationAlerts.js). SOS notifications not reaching trusted
# contacts is a safety-critical failure; no verification mail means password
# signups can never verify and stay restricted.
RESEND_API_KEY=

# Firebase Admin service-account JSON, as a single-line JSON string.
# Missing: ALL push notifications are disabled with one warning
# (services/firebaseService.js:14).
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Missing: Sentry never initializes — backend errors are console-only, with no
# alerting after launch (instrument.js:8).
SENTRY_DSN=

# Missing: defaults to 0.1 (10% of transactions traced).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Monetization — both dormant; see PAYWALL.md and VENUE-BILLING.md
# ---------------------------------------------------------------------------

# Missing/not "true": the consumer Flock Pro paywall stays OFF and everything is
# free (services/entitlements.js:21). This is the intended v1.0 state and the
# kill switch — flipping it to false reverts to free with no client update.
PAYWALL_ENABLED=false

# Missing/not "true": venue B2B billing gates stay off (services/venueEntitlements.js:20).
VENUE_BILLING_ENABLED=false

# Shared secret matching the Authorization header set in the RevenueCat dashboard.
# Missing: the webhook FAILS CLOSED with 503 (routes/revenuecat.js:18) — correct
# and deliberate, because without it anyone could flip is_premium for any user id.
# Consequence of leaving it unset once the paywall is live: purchases never
# grant entitlement.
REVENUECAT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# NFC check-in — FAILS OPEN toward "unverified", which is the safe direction
# ---------------------------------------------------------------------------

# HMAC secret used to sign the place id baked into physical NFC tags
# (routes/checkin.js:16).
# Missing: no tap can ever be signature-verified, so every check-in is recorded
# as 'nfc_unverified' and none of them feed ML calibration/training. Safe, but
# it silently disables the entire physical check-in signal.
NFC_TAG_SECRET=

# ---------------------------------------------------------------------------
# Destructive-operation guards — leave UNSET in production
# ---------------------------------------------------------------------------

# Set to 1 ONLY for a deliberate `node server.js` boot against a Railway
# database host with NODE_ENV != production (the quarterly restore drill's
# "point a local backend at the scratch database" step, a staging boot).
# Unset: server.js refuses that combination outright, because backend/.env
# points DATABASE_URL at the production proxy and a plain local boot runs
# migrations against it (this nearly compounded the 2026-08-13 outage twice).
# Backups never need it — scripts/dump-db.js does not boot the server. Set it
# per-command, never in this file.
I_UNDERSTAND_THIS_IS_PRODUCTION=

# Set to "true" ONLY to allow DROP TABLE / TRUNCATE through the pool guard
# (config/database.js:23, :30). Unset is the safe default: destructive queries
# are rejected. Never set this on the production service.
ALLOW_DROP_TABLES=

# Set to "enabled" to make seeds/demo-data.js refuse to run against production
# (seeds/demo-data.js:29). Unset means the demo seeder is NOT blocked.
DATABASE_PROTECTION=enabled

# scripts/seed-review-account.js refuses to run unless DATABASE_URL points at
# localhost, because it writes accounts whose passwords are committed to this
# repo and upserts over any existing row with those addresses. Set to 1 only
# for a deliberate staging/reviewer seed. Leave UNSET.
SEED_REVIEW_CONFIRM=

# Override the seeded reviewer/buddy passwords so the credentials handed to App
# Review are not the ones published in this repo. Default to the values in
# SUBMISSION.md when unset.
SEED_REVIEWER_PASSWORD=
SEED_BUDDY_PASSWORD=

# scripts/dump-db.js writes ONLY into backend/backups/ (the one gitignored
# directory), because a dump contains bcrypt hashes, Apple refresh tokens, push
# device tokens and password-reset tokens in cleartext. Set to 1 only to write
# a dump to a path outside the repo entirely. Leave UNSET.
DUMP_ALLOW_ANY_PATH=

# ---------------------------------------------------------------------------
# Local scripts only — not needed by the running server
# ---------------------------------------------------------------------------

# The ML collection/training scripts under scripts/ml/ connect via these PG*
# vars when DATABASE_URL is not set. Server code does not read them.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# BestTime.app key — used ONLY by the ML collection scripts, never at runtime.
# PAID and quota-limited: read the ml_besttime_limits notes before any run.
BESTTIME_API_KEY=

# SeatGeek — optional secondary event source for ML collection (scripts/ml/eventService.js:72).
SEATGEEK_CLIENT_ID=

# seeds/demo-data.js only. SEED_REAL_USER_PASSWORD is REQUIRED by that script and
# it throws without it; SEED_REAL_EMAIL defaults to admin@flock.app.
SEED_REAL_EMAIL=
SEED_REAL_USER_PASSWORD=

# Set to "true" to load a crowd model whose ship gate FAILED (services/mlPredictor.js:118).
# Local debugging only — never in production. Unset means a failing artifact is
# refused and the rule engine serves instead.
ML_SHIP_GATE_OVERRIDE=
