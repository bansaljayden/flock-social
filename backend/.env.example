# Flock backend — environment variables
#
# Copy to `backend/.env` for local dev. In production these live in the Railway
# service variables — never commit real values (a gitleaks pre-commit hook enforces this).
#
# Each entry says what BREAKS when it is missing. Three of them fail OPEN
# (moderation, NFC trust, admin provisioning), so a missing value degrades
# safety silently instead of crashing — read those notes before shipping.

# ---------------------------------------------------------------------------
# Core — the server will not work without these
# ---------------------------------------------------------------------------

# Missing: every query fails. server.js logs "DATABASE_URL: [missing]" at boot
# and the pool never connects. Railway injects this automatically.
# QUARANTINE (post-outage 2026-08-13): if this (or PGHOST) points at a Railway
# host (*.rlwy.net / *.railway.app / *.railway.internal) while NODE_ENV is not
# "production", server.js REFUSES to boot — a plain local `node server.js` used
# to run migrations against the live database. See
# I_UNDERSTAND_THIS_IS_PRODUCTION below for the deliberate-use override.
DATABASE_URL=postgresql://user:password@host:5432/flock_db

# Missing: HARD EXIT in production (server.js:8-14). Outside production it only
# warns, and then every login/signup and all authenticated routes throw 500s.
JWT_SECRET=your-super-secret-jwt-key-change-this

# Missing: defaults to 5000 (server.js:335). Railway sets this itself.
PORT=5000

# Missing: treated as development — TLS verification for Postgres is disabled,
# Sentry environment is "development", and the JWT_SECRET guard only warns.
NODE_ENV=development

# Missing: CORS allowlist falls back to http://localhost:3000 (server.js:67), so
# a deployed frontend on any other origin has every API call blocked by CORS.
FRONTEND_URL=http://localhost:3000

# Missing: falls back to https://flock-app-w65m.vercel.app. Used for NFC
# check-in redirects, flock invite links, and the waitlist email logo — so
# links mailed to users point at the old Vercel host instead of flockcorp.com.
PUBLIC_WEB_URL=https://flockcorp.com

# ---------------------------------------------------------------------------
# Auth providers
# ---------------------------------------------------------------------------

# Missing: "Continue with Google" returns 503 (routes/auth.js:243). Must match
# the client's REACT_APP_GOOGLE_CLIENT_ID or the audience check rejects tokens.
GOOGLE_CLIENT_ID=

# Sign in with Apple. APPLE_CLIENT_ID/APPLE_BUNDLE_ID default to
# com.flockcorp.flock. Missing TEAM_ID/KEY_ID/PRIVATE_KEY: account deletion
# still deletes the row but CANNOT revoke the Apple token — Apple 5.1.1(v)
# requires revocation, so this is a review-rejection risk, not just a bug.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=com.flockcorp.flock
APPLE_BUNDLE_ID=com.flockcorp.flock

# ---------------------------------------------------------------------------
# Moderation — fail-CLOSED in production by default. Read this block before any
# store submission.
# ---------------------------------------------------------------------------
#
# THIS BLOCK USED TO SAY "FAILS OPEN", AND IT SHIPPED THE SWITCH THAT WOULD
# MAKE IT TRUE. Round 17 made image screening fail closed by default whenever
# NODE_ENV=production (utils/moderation.js IMAGE_MODERATION_REQUIRED): the only
# way to store an unscreened image on the production service is for somebody to
# write IMAGE_MODERATION_REQUIRED=false, which is a deliberate, greppable act.
# The line below carried exactly that value, so an operator who copied this file
# into a production environment turned the safety default off and had every
# reason to believe they had copied the safe example. It is now EMPTY: unset is
# the correct value in every environment, and it means "screen, and refuse what
# cannot be screened" in production and "allow with a warning" in dev.

# Google Cloud Vision SafeSearch key (enable the Vision API on the same GCP
# project as Places/Gemini). GOOGLE_VISION_API_KEY is accepted as a legacy
# alias.
# Missing IN PRODUCTION: every image upload in the app is REJECTED (fail-closed)
# and the boot logs one loud line saying so. Missing in dev: images are allowed
# with a console warning, which is the intended dev behaviour.
# NOTE: this replaced OpenModerator, whose hosted service was shut down.
# OPENMODERATOR_API_KEY is dead and is read nowhere in this codebase.
VISION_API_KEY=

# LEAVE THIS EMPTY. Empty means: required in production, not required in dev.
#   "true"   -> required everywhere, including dev (every upload 400s without a
#               VISION_API_KEY — useful for testing the refusal path, painful
#               otherwise).
#   "false"  -> NOT required, even in production. This is the one value that can
#               put unscreened photo UGC in front of a 13-year-old, and there is
#               no situation in which it belongs on the production service.
#   unset/'' -> the default above.
IMAGE_MODERATION_REQUIRED=

# Comma-separated user IDs promoted to role='admin' on every boot (server.js:319).
# Missing: NO account has the admin role, so the moderation console is
# unreachable and inbound user reports are never actioned — the exact thing
# Apple Guideline 1.2 requires. Fails silently.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Third-party APIs — features degrade individually, server still boots
# ---------------------------------------------------------------------------

# Google Places (server-side key; do NOT reuse the browser-restricted Maps key).
# Missing: venue search, crowd lookups, venue badges, the venue dashboard and
# Birdie's venue suggestions all return empty or error.
GOOGLE_PLACES_API_KEY=

# Missing: Birdie (the AI assistant) is disabled — routes/ai.js never builds a
# client, so every Birdie request fails.
GEMINI_API_KEY=

# Missing: defaults to gemini-3.5-flash-lite (routes/ai.js:33). Only set this
# to pin or change the Birdie model.
BIRDIE_MODEL=

# OpenWeatherMap. Missing: weather features are skipped with a one-time warning
# and the crowd model loses its weather inputs, degrading prediction accuracy.
WEATHER_API_KEY=

# Missing: the events feed returns nothing AND the ML predictor's nearby-event
# features are all zero (services/mlPredictor.js:351) — a known live gap noted
# in scripts/ml/RETRAIN.md.
TICKETMASTER_API_KEY=

# Missing: safety/SOS alert emails, waitlist confirmations, email verification,
# password reset, and moderation alert emails are all silently skipped
# (routes/safety.js, routes/waitlist.js, services/emailService.js,
# services/moderationAlerts.js). SOS notifications not reaching trusted
# contacts is a safety-critical failure; no verification mail means password
# signups can never verify and stay restricted.
RESEND_API_KEY=

# The Svix signing secret for Resend's delivery webhook, copied from the
# webhook's page in the Resend dashboard. Looks like `whsec_...`.
# Missing: POST /api/email-events answers 503 and nothing is recorded, so no
# hard bounce and no spam complaint ever reaches email_suppressions
# (routes/emailWebhook.js). Flock then keeps mailing addresses that no longer
# exist — the Monday venue digest re-sends to the same dead mailbox every week
# — which is billed per send and spends flockcorp.com's reputation with the
# receiving providers. That reputation is shared across the domain, so the bill
# for ignoring it is eventually the password-reset mail landing in everybody
# else's spam folder. Point the webhook at
# https://<api host>/api/email-events and subscribe it to email.bounced and
# email.complained.
RESEND_WEBHOOK_SECRET=

# Firebase Admin service-account JSON, as a single-line JSON string.
# Missing: ALL push notifications are disabled with one warning
# (services/firebaseService.js:14).
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Missing: Sentry never initializes — backend errors are console-only, with no
# alerting after launch (instrument.js:8).
SENTRY_DSN=

# PostHog project token, used server-side ONLY to capture Birdie's
# $ai_generation/$ai_span events for AI Observability (routes/ai.js). This is
# the same kind of write-only project token REACT_APP_POSTHOG_KEY uses on the
# frontend, not a secret personal API key.
# Missing: Birdie still answers normally — routes/ai.js reads this optionally
# and every capture call is a no-op — but no LLM traces reach PostHog.
#
# SET IS NOT THE SAME AS REPORTING. routes/ai.js only ever builds the client
# when NODE_ENV is production, so a local run holding this key files nothing.
# That is deliberate: a dev machine is not a user, and the frontend measured
# what happens without the rule (1,526 of 1,794 pageviews came from a dev
# server). Use POSTHOG_ALLOW_LOCAL below to opt a local run back in.
POSTHOG_API_KEY=

# Missing: defaults to https://us.i.posthog.com.
POSTHOG_HOST=

# Set to the string true ONLY while deliberately testing that server-side AI
# observability still works end to end, and unset it afterwards. Anything else
# and your Birdie turns are priced into the production cost numbers as if a
# real user had asked. Mirrors REACT_APP_POSTHOG_ALLOW_LOCAL on the frontend.
# Missing: no LLM traces leave a non-production process. That is the intended
# state, not a gap.
POSTHOG_ALLOW_LOCAL=

# Missing: defaults to 0.1 (10% of transactions traced).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Roost, the venue advisor. BOTH FLAGS BELOW DEFAULT ON, which is unusual in
# this file: everything under Monetization defaults off, because the safe
# direction for a gate that meters money is closed. These two gate a surface
# that is INVISIBLE when it is off, and an invisible feature is not a safe
# default, it is a feature nobody can find. NIGHT_CONTEXT_ENABLED below is the
# only other flag in the codebase that defaults on, for the same reason.
# ---------------------------------------------------------------------------

# Missing/empty: ON. Set to "false": the deterministic template twin writes every
# chip answer instead of the model (services/advisorPhrasing.js). Nothing becomes
# untrue when it is off, because the template carries the same facts from the
# same fact engine; the answers just read as one line per fact rather than as
# sentences. What DOES break when it is off: typed questions, all of them. Free
# text has no template to fall back to, so ADVISOR_FREETEXT_ENABLED is dead
# whenever this is false, GET /questions reports freeText false, and the field
# on the dashboard is drawn disabled with the reason under it.
ADVISOR_PHRASING_ENABLED=true

# Missing/empty: ON. Set to "false": the typed question field on the venue
# dashboard is drawn disabled and POST /api/venue/advisor/question declines in
# plain words before it spends anything (services/advisorFreeText.js). The chips
# are unaffected. This is a kill switch, not a launch switch: it defaults on
# because both flags shipped default OFF on 2026-08-20, which made a built and
# tested feature invisible on every deploy including the owner's own preview.
# Free text also needs GEMINI_API_KEY; without a key it declines regardless.
ADVISOR_FREETEXT_ENABLED=true

# Missing: defaults to gemini-3.7-flash. A name the API 404s is swapped once, in
# process, for Birdie's known-good gemini-3.5-flash-lite, so a wrong value here
# costs wording quality and never truthfulness. Only set this to pin or change
# the Roost model; it is read at boot and by both the chip and typed paths.
ADVISOR_MODEL=

# Missing/empty: ON. Set to "false", "0", "off" or "no": the nightly context
# sweep stops running and the crowd alerts that depend on it go quiet
# (services/nightContext.js:83). It defaults on because the sweep is what keeps
# tonight's listings and conditions fresh, and a stale night is worse than an
# absent one.
NIGHT_CONTEXT_ENABLED=true

# ---------------------------------------------------------------------------
# Monetization — both dormant; see PAYWALL.md and VENUE-BILLING.md
# ---------------------------------------------------------------------------

# Missing/not "true": the consumer Flock Pro paywall stays OFF and everything is
# free (services/entitlements.js:21). This is the intended v1.0 state and the
# kill switch — flipping it to false reverts to free with no client update.
PAYWALL_ENABLED=false

# Missing/not "true": venue B2B billing gates stay off (services/venueEntitlements.js:20).
VENUE_BILLING_ENABLED=false

# Missing/not "true": the Monday venue digest email never sends and its hourly
# sweep reads nothing (services/venueDigest.js). Flipping it on still mails only
# venue owners whose dashboard "Weekly reports" switch is on
# (venue_profiles.notification_prefs.weekly, default false) with a verified
# address, on Monday morning in the venue's own timezone, deduped across
# deploys by venue_digest_sends (migration 033). Every email carries a signed
# one-click unsubscribe link (GET /api/venue-digest/opt-out).
DIGEST_ENABLED=false

# Shared secret matching the Authorization header set in the RevenueCat dashboard.
# Missing: the webhook FAILS CLOSED with 503 (routes/revenuecat.js:18) — correct
# and deliberate, because without it anyone could flip is_premium for any user id.
# Consequence of leaving it unset once the paywall is live: purchases never
# grant entitlement.
REVENUECAT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# NFC check-in — FAILS OPEN toward "unverified", which is the safe direction
# ---------------------------------------------------------------------------

# HMAC secret used to sign the place id baked into physical NFC tags
# (routes/checkin.js:16).
# Missing: no tap can ever be signature-verified, so every check-in is recorded
# as 'nfc_unverified' and none of them feed ML calibration/training. Safe, but
# it silently disables the entire physical check-in signal.
NFC_TAG_SECRET=

# ---------------------------------------------------------------------------
# Variables the code reads that this file did not mention
# ---------------------------------------------------------------------------
# This file's whole claim is that it is the authoritative list. Fifteen
# variables were being read by shipping code and were absent from it, and two of
# those are secrets. An undocumented variable is not a small tidiness problem
# here: the only place anyone can learn that BAN_TOMBSTONE_SECRET falls back to
# JWT_SECRET is the source, and that fallback silently turns a JWT rotation into
# a ban amnesty.

# Pepper for the HMAC digests in `banned_identities` (migration 012) — the
# hashes of email/phone/oauth id that make a ban survive a re-signup.
# routes/auth.js:529, routes/auth.js:1346, routes/users.js:584.
# Missing: FALLS BACK TO JWT_SECRET, then to the empty string. That fallback is
# the thing to know about. Rotating JWT_SECRET — which is a routine, encouraged,
# already-performed operation — silently changes the pepper, so every digest
# written before the rotation stops matching anything computed after it, and
# every previously banned identity can register again with the same address.
# Nothing logs when that happens. Set this to its own value so the ban ledger
# and the session-signing key can be rotated independently.
BAN_TOMBSTONE_SECRET=

# Pepper for the HMAC digests in users.phone_hash (migration 051) - the keyed
# hashes POST /api/friends/find-by-phone matches an uploaded contact list
# against. utils/phone.js.
# Missing: FALLS BACK TO JWT_SECRET, then to the empty string. With no key at
# all, discovery is DISABLED rather than downgraded to a bare SHA-256, because a
# 10-digit phone number is reversible from an unkeyed hash in seconds; the route
# answers with an empty result and logs. The JWT_SECRET fallback has the same
# rotation hazard as BAN_TOMBSTONE_SECRET above, with a different symptom:
# rotating JWT_SECRET makes every stored phone digest stop matching, so everyone
# who opted in to being findable by their number silently stops being findable
# until they toggle it off and on again. Set this to its own value.
# ROTATING THIS ON PURPOSE is a supported operation and its cost is exactly
# that: the phone_hash column has to be rebuilt, and the only place the numbers
# still exist in a form that can rebuild it is users.phone.
CONTACT_DISCOVERY_SECRET=

# Comma-separated ABSOLUTE origins added to the CORS allowlist (server.js:239).
# UNSET IS THE PRODUCTION STATE and is load-bearing. This variable exists
# because the preview-URL regex it replaced was bypassed twice: *.vercel.app is
# a self-service namespace, so any pattern over it is a pattern over hostnames
# an attacker can register (SECURITY-AUDIT-auth.md R2-1). A preview deploy that
# needs to reach this backend opts itself in through its own deploy's env; the
# production service leaves this empty. Entries that are not absolute origins
# are dropped, and a non-empty value logs a [cors] warning at boot.
EXTRA_CORS_ORIGIN=

# Postgres TLS mode, and the highest-priority input to that decision
# (config/database.js:18). An explicit value always wins, because whoever set it
# knew the endpoint; "disable" turns TLS off, anything else means TLS with a
# self-signed certificate tolerated. Missing: DATABASE_URL deployments get TLS
# when NODE_ENV=production and none otherwise. This is documented because
# getting it wrong once already cost a production outage — the pool force-
# enabled TLS against Railway's INTERNAL host and every connection died at the
# handshake, before a single query, with nothing in the logs naming the cause.
# It IS set on the production Railway service.
PGSSLMODE=

# Overrides the pool's 15s server-side statement_timeout (config/database.js:63).
# 0 disables the cap entirely. The API server must never set this: the cap is
# what stops one query blocked on a lock from parking a pool slot forever, and
# twenty of those stop the whole API. It is for the one-shot jobs whose purpose
# is a long aggregate — `PG_STATEMENT_TIMEOUT_MS=0 node scripts/ml/...`.
# Negative values are rejected and fall back to the default, which is the
# direction that keeps the cap on.
PG_STATEMENT_TIMEOUT_MS=

# Set to "true" to make a NON-server process run the boot connectivity ping
# (config/database.js:229). The ping otherwise runs only when this process's
# entry point is server.js, which is deliberate: requiring the pool is not the
# same as booting the API, and every test file and one-shot script used to open
# a real connection just by loading a helper three levels down.
PG_STARTUP_PING=

# Set to "1" to let a boot refresh the seeded demo accounts' expired picsum
# stories (server.js postBootTasks). UNSET IS THE PRODUCTION STATE. This ran
# unconditionally once, which made a 24-hour story permanent: anyone friended
# with a demo account — App Review included — saw stock photos presented as a
# real friend's story, forever, which is the "no stock photos, no seed data in
# production" rule the review checklist exists to enforce.
KEEP_DEMO_STORIES=

# Set to "true" to REQUIRE a nonce on the Apple / Google id tokens
# (routes/auth.js:2922, routes/auth.js:2524). Unset means a token that carries
# no nonce is still accepted, which is the compatibility default for the
# clients that do not send one. Turning these on is a client-side change first.
APPLE_REQUIRE_NONCE=
GOOGLE_REQUIRE_NONCE=

# Alternative name for VISION_API_KEY (utils/moderation.js:94). VISION_API_KEY
# wins if both are set. Only one of the two needs a value.
GOOGLE_VISION_API_KEY=

# Comma-separated recipients for moderation alert email
# (services/moderationAlerts.js:118). Missing: no alert is mailed, so a report
# waits in the queue until someone opens the console. IS set in production.
MODERATION_ALERT_EMAIL=

# Extra city keys for the nightly context sweep, beyond the ones derived from
# verified claimed venues (services/nightContext.js:174). Missing: the derived
# set is used alone, which is the intended state.
NIGHT_CONTEXT_CITIES=

# RevenueCat entitlement identifier checked by the webhook
# (routes/revenuecat.js:120). Missing: defaults to "pro". Only matters once
# PAYWALL_ENABLED is on and the entitlement in the RevenueCat dashboard is
# named something other than "pro".
REVENUECAT_ENTITLEMENT_ID=

# Extra hours a story's row survives past expiry before the purge removes it
# (routes/stories.js:183). Missing: the built-in grace applies.
STORY_RETENTION_GRACE_HOURS=

# Base URL used when an email needs to link at the API rather than the web app
# (services/emailService.js:180). Missing: falls back to the production API URL,
# so a staging deploy mails links pointing at production.
PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Destructive-operation guards — leave UNSET in production
# ---------------------------------------------------------------------------

# Set to 1 ONLY for a deliberate `node server.js` boot against a Railway
# database host with NODE_ENV != production (the quarterly restore drill's
# "point a local backend at the scratch database" step, a staging boot).
# Unset: server.js refuses that combination outright, because backend/.env
# points DATABASE_URL at the production proxy and a plain local boot runs
# migrations against it (this nearly compounded the 2026-08-13 outage twice).
# Backups never need it — scripts/dump-db.js does not boot the server. Set it
# per-command, never in this file.
I_UNDERSTAND_THIS_IS_PRODUCTION=

# Set to "true" ONLY to allow DROP TABLE / TRUNCATE through the pool guard
# (config/database.js:23, :30). Unset is the safe default: destructive queries
# are rejected. Never set this on the production service.
ALLOW_DROP_TABLES=

# Set to "enabled" to make seeds/demo-data.js refuse to run against production
# (seeds/demo-data.js:29). Unset means the demo seeder is NOT blocked.
DATABASE_PROTECTION=enabled

# The second half of that guard, and the half that catches the case
# DATABASE_PROTECTION does not: seeds/demo-data.js refuses to touch a NON-local
# database at all, and refuses to run unattended (no TTY), unless this is "1"
# (seeds/demo-data.js:56, :83). Leave UNSET. Setting it in a deploy environment
# would let a CI step seed demo accounts into a real database without anyone
# answering a prompt.
SEED_DEMO_CONFIRM=

# scripts/seed-review-account.js refuses to run unless DATABASE_URL points at
# localhost, because it writes accounts whose passwords are committed to this
# repo and upserts over any existing row with those addresses. Set to 1 only
# for a deliberate staging/reviewer seed. Leave UNSET.
SEED_REVIEW_CONFIRM=

# Override the seeded reviewer/buddy passwords so the credentials handed to App
# Review are not the ones published in this repo. Default to the values in
# SUBMISSION.md when unset.
SEED_REVIEWER_PASSWORD=
SEED_BUDDY_PASSWORD=

# scripts/dump-db.js writes ONLY into backend/backups/ (the one gitignored
# directory), because a dump contains bcrypt hashes, Apple refresh tokens, push
# device tokens and password-reset tokens in cleartext. Set to 1 only to write
# a dump to a path outside the repo entirely. Leave UNSET.
DUMP_ALLOW_ANY_PATH=

# ---------------------------------------------------------------------------
# Local scripts only — not needed by the running server
# ---------------------------------------------------------------------------

# The ML collection/training scripts under scripts/ml/ connect via these PG*
# vars when DATABASE_URL is not set. Server code does not read them.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# BestTime.app key — used ONLY by the ML collection scripts, never at runtime.
# PAID and quota-limited: read the ml_besttime_limits notes before any run.
BESTTIME_API_KEY=

# SeatGeek — optional secondary event source for ML collection (scripts/ml/eventService.js:72).
SEATGEEK_CLIENT_ID=

# seeds/demo-data.js only. SEED_REAL_USER_PASSWORD is REQUIRED by that script and
# it throws without it; SEED_REAL_EMAIL defaults to admin@flock.app.
SEED_REAL_EMAIL=
SEED_REAL_USER_PASSWORD=

# Set to "true" to load a crowd model whose ship gate FAILED (services/mlPredictor.js:118).
# Local debugging only — never in production. Unset means a failing artifact is
# refused and the rule engine serves instead.
ML_SHIP_GATE_OVERRIDE=

# Set to "true" to run the published crowd score through the dispersion quantile
# map (services/mlPredictor.js applyScoreQuantileMap). UNSET IS THE SHIPPED STATE
# and this is a product decision, not a tuning knob: the map trades average
# accuracy for hit rate, and both halves are measured.
#
#   ON:  within-10 20.8% -> 29.2%  (about 8 more venue cards in every hundred
#        land within 10 of the truth), and the published spread stops being
#        1.7x too narrow (sd/actual 0.58 -> 0.93)
#   OFF-to-ON cost: MAE 30.0 -> 33.1, and misses bigger than 75 points go
#        2.4% -> 10.2% of rows. It says 0 and 100 far more often, and it is
#        wrong at the rails when it is wrong.
#
# The gate refuses it as written (RETRAIN.md carries the drafted two-metric
# alternative, also unarmed). Read scripts/ml/train/QMAP-DECISION.md before
# setting this. The same variable is read by scripts/ml/train/quick_eval.py, so
# a gate run and the serve path can never be scored on different arithmetic.
CROWD_QMAP_ENABLED=
