# Flock venue sensor configuration.
#
# The installed copy lives at /etc/flock-sensor/flock_sensor.env, mode 0600.
# It contains a live credential. Never commit a filled-in copy of this file.

# The device key for THIS venue, issued when the device row is provisioned.
# See README.md, "Provisioning a device". Treat it like a password: anyone
# holding it can post occupancy readings for this venue.
FLOCK_API_KEY=your_api_key_here

# Must be https. The key travels in a request header over the venue's wifi.
FLOCK_API_URL=https://flock-app-production.up.railway.app/api/sensors/data

# Must match the device_id the key was issued against. The backend rejects a
# mismatch, which is how you find out a Pi was flashed with the wrong venue's
# key before it spends a month reporting one bar's crowd as another's.
SENSOR_DEVICE_ID=sensor_001

# Seconds between readings. Minimum 10.
PUSH_INTERVAL_SECONDS=30

# auto = show the dashboard only if a framebuffer exists (demo units).
DISPLAY_ENABLED=auto

# --- Optional tuning. Defaults are fine for most doorways. -----------------

# The V4L2 node the Lepton's USB breakout came up on. /dev/video0 on a Pi with
# nothing else plugged in; `v4l2-ctl --list-devices` says for certain. Some
# PureThermal firmware exposes two nodes and only one of them is radiometric.
#THERMAL_DEVICE=/dev/video0

# A pixel counts as warm at this temperature, or this far above the frame's own
# median, whichever is higher. On a Lepton the median-relative margin does
# nearly all the work, because absolute accuracy without a calibration target
# is several degrees. Raise THERMAL_MARGIN_C if a hot venue reports a
# suspiciously low headcount; lower it if empty rooms report people.
#THERMAL_THRESHOLD_C=28.0
#THERMAL_MARGIN_C=3.0

# Pixels are mean-pooled into bin x bin cells before counting, so these two are
# coupled: THERMAL_MIN_CLUSTER counts CELLS in the binned grid, not raw pixels.
# At bin 4 the grid is 40x30 and one cell is sixteen pixels, so 12 cells is 192
# pixels of the sensor's 19,200.
#
# BIN 4 IS BENCH-SET, 2026-09-06: bin 2 broke one person into 3 clusters at
# about 3 ft, bin 4 reads 1. Raise THERMAL_BIN before THERMAL_MIN_CLUSTER if
# one person reads as several. See README.md, Calibration, and re-derive if you
# change either: they are not independent.
#
# MIN_CLUSTER 6 is a head at about three metres, 96 raw pixels, so somebody
# partly in frame still counts; 12 needed most of a body in shot. Below 5 is
# where sensor noise starts reading as people. Run `main.py --calibrate` with
# the camera mounted where it will live: it measures this room's noise and a
# real person at the far edge of the crossing, then prints the value that sits
# between them.
#THERMAL_BIN=4
#THERMAL_MIN_CLUSTER=6
#
# Nothing whose average reads hotter than this counts as a person: a mug of
# coffee, a lamp, a heater. Well above skin, because an uncalibrated Lepton
# can read several degrees high.
#THERMAL_MAX_PERSON_C=45.0

# The people counter. auto uses the trained model in models/people.onnx when it
# and onnxruntime are installed (setup.sh installs both), and the heat-cluster
# rule above otherwise; off always uses the rule. The threshold is how sure the
# model must be: raise it if a pet counts, lower it if people half out of view
# are missed. training/README.md says how the model was made.
#THERMAL_MODEL=auto
#THERMAL_MODEL_THRESHOLD=0.4

# The live thermal view on a demo unit's touchscreen: tap the panel to see what
# the camera sees, tap again to go back. It only does anything on a unit that HAS
# a screen, which means a demo unit; a venue box is headless and holds no frame.
# Set 0 if a unit with a panel is ever installed at a venue. See README.md, The
# thermal view.
#THERMAL_VIEW=1

# The panel size, used only as a fallback. The program asks the framebuffer
# what it actually got and lays out against that, so these matter only when the
# framebuffer cannot say. Defaults are the 7 inch 1024x600 HDMI panel; the
# layout switches to three stacked readings on its own if a panel is taller
# than it is wide.
#DISPLAY_W=1024
#DISPLAY_H=600

# The doorway counter. A VL53L8CX reads an 8x8 grid of distances over I2C and
# counts people crossing it, with direction, which a beam cannot. Bring it up
# with `main.py --tof`. See README.md, The doorway counter.
#
# DOOR_SENSOR  auto uses the VL53L8CX if one answers at start-up and the GPIO
#              pin if not. On a unit with the counter fitted, set tof: it then
#              keeps retrying a counter that did not answer at boot instead of
#              falling back to a beam that is not there.
# TOF_AXIS     row if people cross the grid top to bottom as mounted, col if
#              side to side. `--tof` says which when nothing crosses.
# TOF_FLIP_DIRECTION  1 if arrivals come out as departures.
#DOOR_SENSOR=auto
#TOF_AXIS=row
#TOF_FLIP_DIRECTION=0
#
# The empty doorway is learned zone by zone at every start, so there is no
# floor distance to measure. These tune the counting, and the defaults are
# the reasoned ones:
# TOF_MARGIN_MM    how much nearer than its floor a zone has to read to count
#                  as somebody. A head at doorway range is about a metre nearer.
# TOF_MIN_CLUSTER  zones a person must fill. One zone is about 30 cm of floor,
#                  so a lone lit zone is a reflection, not somebody.
#TOF_MARGIN_MM=300
#TOF_MIN_CLUSTER=3
#TOF_TRACK_MISSES=5
#TOF_MAX_JUMP=3.0

# The base's two lights, by GPIO number. 0 drives nothing. Each LED needs a
# 330 ohm resistor in series. See README.md, The lights.
#LED_POWER_GPIO=23
#LED_LINK_GPIO=24

# Noise calibration. Until these are set with a sound level meter, the reported
# figure is a relative loudness index, not calibrated dB SPL. See README.md.
#NOISE_REF_COUNTS=1.0
#NOISE_DB_OFFSET=50.0
#
# Microseconds between the microphone's reads. `main.py --listen --write`
# measures this unit's best gap and writes it with the settings above.
#NOISE_SAMPLE_GAP_US=1000
#
# One phone sound-meter reading turns the panel's level into estimated decibels.
# `main.py --anchor 62 --write`, with 62 replaced by what the phone shows,
# measures the microphone and writes these two lines itself.
#NOISE_SPL_ANCHOR_COUNTS=0.0
#NOISE_SPL_ANCHOR_DB=0.0

# Only for pointing a bench unit at a local backend. Never set this in a venue.
#ALLOW_INSECURE_URL=false
