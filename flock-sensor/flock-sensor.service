[Unit]
Description=Flock Venue Sensor
Documentation=https://github.com/flock/flock-app/tree/main/flock-sensor
# The device needs a network AND a correct clock: with an unset clock the TLS
# handshake fails ("certificate is not yet valid") and every push is refused.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

# StartLimitIntervalSec=0 disables systemd's give-up rule. The default (5 fast
# restarts and the unit stays dead) is exactly wrong for a box in a venue with
# nobody to restart it: a transient boot-order problem would take the sensor
# offline until someone drove out to it.
StartLimitIntervalSec=0

[Service]
Type=simple
# setup.sh rewrites User/Group to whoever actually owns the Pi. `pi` no longer
# exists by default on Raspberry Pi OS images since 2022.
User=pi
Group=pi
# Hardware access: video (the USB thermal camera's V4L2 node AND the demo
# unit's framebuffer), SPI (mic ADC), GPIO (break-beam). The thermal camera
# moved from I2C to USB, so i2c is no longer in this list.
SupplementaryGroups=spi gpio video

WorkingDirectory=/opt/flock-sensor
ExecStart=/usr/bin/python3 /opt/flock-sensor/main.py

# Config lives outside any home directory so the service works whatever the
# login user is called. Mode 0600, owned by the service user, because it holds the
# device API key.
Environment=FLOCK_CONFIG=/etc/flock-sensor/flock_sensor.env
Environment=FLOCK_LOG=/var/log/flock-sensor/flock_sensor.log
Environment=FLOCK_BUFFER=/var/lib/flock-sensor/buffer.json
Environment=PYTHONUNBUFFERED=1

# systemd creates these with the right owner and mode on every start.
StateDirectory=flock-sensor
LogsDirectory=flock-sensor

Restart=always
RestartSec=10

# Hardening, and the distinction this comment used to blur.
#
# Still deliberately NOT ProtectSystem=strict or DevicePolicy=closed: this
# process needs /dev/video0, /dev/spidev0.0, /dev/gpiomem and possibly /dev/fb0,
# and a sensor that is beautifully sandboxed but cannot read its sensors is
# worse than one that can. `strict` would also make /var read-only, and the
# buffer and the log both live there.
#
# ProtectSystem=full is a different setting and was being refused along with
# it. It makes /usr, /boot and /etc read-only and does not touch /dev at any
# level, so every device above is unaffected. What it stops is the thing this
# box is actually exposed to: it sits in a venue, on someone else's wifi, in a
# room full of strangers, and the one file that matters is
# /etc/flock-sensor/flock_sensor.env — owned by the service user so that the
# service can read it, which also meant the service could REWRITE it. A process
# that got a shell here could repoint FLOCK_API_URL at its own collector and
# hand it the venue's device key, and the unit did nothing to prevent that.
# Now /etc is read-only to this service and the installer, which runs as root
# outside the unit, still writes it normally.
#
# No ReadWritePaths here, deliberately. StateDirectory and LogsDirectory are
# already declared further up, and they do the job better: systemd creates
# /var/lib/flock-sensor and /var/log/flock-sensor with the right owner before
# the process starts AND grants this unit write access to them. A bare
# ReadWritePaths would add nothing and would refuse to start the unit on any
# machine where the paths did not exist yet.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
